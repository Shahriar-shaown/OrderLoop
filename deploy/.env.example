# OrderLoop single-host deployment: every variable deploy/docker-compose.yml reads, with a SAFE PLACEHOLDER value.
#
#   ./deploy/generate-secrets.sh        creates deploy/.env from this file with every secret filled in (mode 600, nothing printed)
#   or: cp deploy/.env.example deploy/.env  and replace every CHANGE_ME yourself.
#
# deploy/.env holds secrets: it is git-ignored, never commit it, never paste it into a ticket or a chat. Values here are placeholders,
# not credentials. Optional settings are commented out: leave a setting commented rather than blank (blank is also read as "not set").
# The same names are documented for the application in the repository's .env.example and docs/operations/deployment.md section 3.

# =====================================================================================================================
# Public addresses and the reverse proxy (Caddy)
# =====================================================================================================================
# The web app is served at app.<DOMAIN> and the API at api.<DOMAIN>: same registrable domain, which the refresh-cookie design
# requires. Point both DNS names at this host BEFORE the first start (Let's Encrypt must reach port 80 and 443).
DOMAIN=example.com
# Where Let's Encrypt sends expiry notices.
ACME_EMAIL=admin@example.com
# Host ports of Caddy, the only published ports. Change only for local testing; Let's Encrypt needs 80 and 443.
HTTP_PORT=80
HTTPS_PORT=443
# Extra Caddy global options. Empty (leave commented) in production. `local_certs` makes Caddy use its own CA, for a local test.
# CADDY_GLOBAL_OPTIONS=local_certs
# Tag of the locally built images (orderloop-api:<tag>, ...). Use the release tag you built from.
IMAGE_TAG=local

# =====================================================================================================================
# Database and Redis (internal network only; nothing here is published on the host)
# =====================================================================================================================
POSTGRES_DB=orderloop
# The PostgreSQL superuser: creates the roles, runs the restore drill. Never given to api or worker.
POSTGRES_USER=orderloop
POSTGRES_PASSWORD=CHANGE_ME
# Runtime role used by api and worker (NOBYPASSRLS, DML only).
DATABASE_APP_PASSWORD=CHANGE_ME
# Owner role used only by the migrate job.
DATABASE_MIGRATOR_PASSWORD=CHANGE_ME
# Read-only role that BYPASSES row-level security, used only by the backup job (a dump needs it: see backup-and-restore.md).
DATABASE_BACKUP_PASSWORD=CHANGE_ME
# Statistics-only role for the PostgreSQL exporter (monitoring profile).
DATABASE_MONITOR_PASSWORD=CHANGE_ME
# Passwords are placed inside connection URLs: use only letters and digits (generate-secrets.sh uses hex).
REDIS_PASSWORD=CHANGE_ME

# =====================================================================================================================
# API and worker (validated at start-up by packages/contracts/src/server-env.ts; a bad value stops the process, listing the problem)
# =====================================================================================================================
# NODE_ENV is fixed to production by the compose file; API_PORT (4000), DATABASE_URL and REDIS_URL are built from the values above.
# NODE_ENV=production
# API_PORT=4000
# DATABASE_URL=
# REDIS_URL=

# --- Sign-in tokens: EdDSA key pair, base64 PEM. REQUIRED in production. generate-secrets.sh creates them.
JWT_PRIVATE_KEY=CHANGE_ME
JWT_PUBLIC_KEY=CHANGE_ME
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_REUSE_GRACE_SECONDS=10

# --- Sign-up policy. REQUIRED in production, no default: the server refuses to start without it.
#   allowlist : only the emails below can create a business (pilot). open : anyone can.
REGISTRATION_MODE=allowlist
# Comma-separated exact emails and/or @domain.com entries. Required when REGISTRATION_MODE=allowlist.
REGISTRATION_ALLOWED_EMAILS=owner@example.com

# --- Origins and proxy. Defaults are derived from DOMAIN.
# WEB_ORIGINS=https://app.example.com
# WEB_APP_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com
# TRUST_PROXY=1
# Fixed to false by the compose file: clients reach the API through Caddy, never directly (see TRUST_PROXY_NONE_OK in docs/operations/deployment.md).
# TRUST_PROXY_NONE_OK=false
# OPENAPI_PUBLIC=false
# Fixed to true by the compose file: never switch the per-IP request limits off outside automated tests.
# RATE_LIMIT_ENABLED=true

# --- Data deletion (docs/privacy-and-deletion.md): days between an owner asking to delete a business and its permanent deletion by the worker.
# TENANT_DELETION_GRACE_DAYS=14
# Address shown on the public /data-deletion page (build argument of the web image). Set a real one before launch.
# NEXT_PUBLIC_PRIVACY_CONTACT=privacy@example.com

# --- Public address compiled into the web app's browser bundle (build argument: changing it means rebuilding the web image).
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_APP_ENV=production

# --- Email. Production requires smtp with STARTTLS (or SMTP_SECURE=true). Test it: docker compose exec api node dist/scripts/mail-test.js --to you@example.com
MAIL_PROVIDER=smtp
MAIL_FROM=OrderLoop <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Logging
LOG_LEVEL=info

# --- Couriers. COURIER_CREDENTIALS_KEY seals each seller's courier credentials (32 random bytes, base64). Losing it makes the
#     saved credentials unreadable; back it up separately from database backups.
COURIER_CREDENTIALS_KEY=CHANGE_ME
# COURIER_CREDENTIALS_KEY_ID=k1
# COURIER_CREDENTIALS_OLD_KEYS=
# The simulated courier (nothing real is booked). Off in production unless set to true.
# COURIER_MOCK_ENABLED=true

# --- Notifications (docs/automation.md)
PUSH_PROVIDER=dev
# PUSH_DEV_OUTBOX=
# EXPO_ACCESS_TOKEN=
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none

# --- Meta (Facebook Page / Instagram). REQUIRED in production, no default.
#   mock : simulated, no Meta account involved. live : the real Meta (never tested with authorised credentials, docs/meta.md).
META_MODE=mock
# META_ALLOW_MOCK_IN_PRODUCTION=false
# META_APP_ID=
# META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
# META_GRAPH_VERSION=
# META_LOGIN_CONFIG_ID=
# META_RETENTION_DAYS=30

# --- TikTok Shop (docs/tiktok-shop.md): a READ-ONLY order mirror in the shop's own currency that keeps stock honest. REQUIRED in
# production, no default. TikTok Shop is not available in Bangladesh: these orders never enter OrderLoop's own (BDT) orders or finance.
#   mock : a labelled simulated shop, no TikTok account involved. live : the real TikTok Shop API (never tested with credentials).
TIKTOK_MODE=mock
# TIKTOK_ALLOW_MOCK_IN_PRODUCTION=false
# Live needs TIKTOK_APP_KEY, TIKTOK_APP_SECRET (16+ characters), API_PUBLIC_URL (https) and COURIER_CREDENTIALS_KEY.
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
# TIKTOK_AUTH_HOST=https://auth.tiktok-shops.com
# TIKTOK_API_HOST=https://open-api.tiktokglobalshop.com
# TIKTOK_API_VERSION=202309
# Days to keep mirrored orders in a final state (webhook events are kept 30 days). At least 30.
# TIKTOK_RETENTION_DAYS=180

# --- Monitoring. /metrics on the API and on the worker's health server answers 404 until this is set, then needs it as a bearer token.
#     Prometheus (monitoring profile) reads it from here. 16+ characters.
METRICS_TOKEN=CHANGE_ME
# Port of the worker's health/metrics server inside its container (fixed to 4010 by the compose file).
# WORKER_HEALTH_PORT=4010

# =====================================================================================================================
# Backups (docs/operations/backup-and-restore.md)
# =====================================================================================================================
# age PUBLIC key the backups are encrypted to (the matching private key is NOT on this host: generate-secrets.sh writes it to
# deploy/backup-age-identity.txt for you to move off-host and store safely; without it no backup can be restored).
BACKUP_AGE_RECIPIENT=CHANGE_ME
# Daily backup time (UTC, HH:MM), and how many to keep: the newest of each of the last N days, then of each of the last M weeks.
# BACKUP_AT=02:30
# BACKUP_ON_START=if-missing
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# The container reports unhealthy when the newest backup is older than this.
# BACKUP_MAX_AGE_HOURS=26
# Optional off-site copy, any S3-compatible storage, through rclone remote "offsite" (all four must be set to enable it):
# BACKUP_RCLONE_REMOTE=offsite:my-bucket/orderloop
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# =====================================================================================================================
# Monitoring profile: docker compose --profile monitoring up -d  (Prometheus, Alertmanager, Grafana; bound to 127.0.0.1 only)
# =====================================================================================================================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Where Alertmanager posts alerts (Slack/Teams/other webhook, or your own receiver). A placeholder here sends nothing useful.
ALERT_WEBHOOK_URL=http://alert-receiver.invalid/hook
# PROMETHEUS_PORT=9090
# ALERTMANAGER_PORT=9093
# GRAFANA_PORT=3001
