# Copy to .env (`cp .env.example .env`). Values below are local-development defaults that match
# infra/docker-compose.yml. They are not secrets. NEVER put real credentials in this file.

# --- Server (api, worker) ---
# Required. development | test | production. Production enforces signing keys and a real mail provider.
NODE_ENV=development
API_PORT=4000
# Runtime role (app_user): NOBYPASSRLS, DML only. This is what api and worker use.
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5433/orderloop
# Migration role (app_migrator): owns tables, runs `prisma migrate`.
DATABASE_MIGRATION_URL=postgresql://app_migrator:app_migrator_dev@localhost:5433/orderloop
# Superuser, used ONLY by `pnpm db:setup` to create the two roles above. Never used at runtime.
DATABASE_ADMIN_URL=postgresql://orderloop:orderloop@localhost:5433/orderloop
REDIS_URL=redis://localhost:6379

# --- Auth ---
# EdDSA (Ed25519) signing key as a base64-encoded PKCS8 PEM, with the matching SPKI public key.
# Leave unset in development: an ephemeral key is generated at start-up (tokens die on restart).
# REQUIRED in production. Generate with: pnpm --filter @orderloop/api auth:generate-keys
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Browser origins allowed to call the API with cookies (comma-separated).
WEB_ORIGINS=http://localhost:3000
# Reverse-proxy hops in front of the API (0 = none). Set to the exact hop count in production so client IPs
# (rate limits, audit log) are real and X-Forwarded-For cannot be spoofed.
TRUST_PROXY=0

# --- Couriers ---
# Courier credentials (Pathao, Steadfast) are stored encrypted with this key and never leave the API. 32 random bytes, base64:
#   openssl rand -base64 32
# Without it, couriers that need credentials cannot be connected (the simulated courier still works). Losing the key makes the
# saved credentials unreadable: sellers would have to enter them again. Rotate by setting a new key + id and moving the old one
# into COURIER_CREDENTIALS_OLD_KEYS=id:base64 (see docs/couriers.md).
# COURIER_CREDENTIALS_KEY=
# COURIER_CREDENTIALS_KEY_ID=k1
# COURIER_CREDENTIALS_OLD_KEYS=
# The simulated courier (nothing real is booked). On by default outside production; switch on deliberately there.
# COURIER_MOCK_ENABLED=true
# Public address of this API, shown to sellers as the webhook URL to paste into their courier's panel (must be https in production).
# API_PUBLIC_URL=https://api.example.com

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent. Output is one JSON object per line; credentials are redacted.
LOG_LEVEL=info

# --- Email ---
# console : prints each email (including its one-time link) to the API log. Local development only; refused in production.
# smtp    : sends through SMTP_*. Locally use Mailpit (`pnpm services:mail`, inbox at http://localhost:8025):
#             MAIL_PROVIDER=smtp  SMTP_HOST=127.0.0.1  SMTP_PORT=1025
#           In production use your provider's SMTP credentials (see docs/api.md, "Email").
MAIL_PROVIDER=console
MAIL_FROM=OrderLoop <no-reply@orderloop.invalid>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Automation and notifications (docs/automation.md) ---
# Push: `dev` (default) only logs a redacted line and records the push as sent; set PUSH_DEV_OUTBOX to also append what it would
# have sent to a file (`tail -f` it). Nothing reaches a phone. `expo` posts to Expo's free push service (production). Give the API
# and the worker the same value; `dev` in production logs a loud warning.
PUSH_PROVIDER=dev
# PUSH_DEV_OUTBOX=/tmp/orderloop-push.jsonl
# EXPO_ACCESS_TOKEN=
# SMS and WhatsApp: `none` (default) makes the channel unavailable (422 channel_not_configured); `console` only logs. No vendor is
# integrated. Either also needs each recipient's own recorded consent.
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

# --- Mobile (Expo) ---
# A physical phone cannot reach "localhost"; use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development
# Which build the app is (name and identifiers; see apps/mobile/app.config.ts): development (default) | preview | production.
# The EAS build profiles in apps/mobile/eas.json set it; a cloud build without it stops with an error.
# APP_VARIANT=development
# Marketing version of the app, and the Expo project id for `eas build` (created by `eas init`).
# The web app's host (e.g. app.example.com): when set, emailed links open the mobile app (see docs/mobile.md).
# APP_WEB_HOST=
# APP_VERSION=1.0.0
# EAS_PROJECT_ID=

# --- Development and test helpers (all optional) ---
# Per-IP request limits of the API; switched off by the browser tests. Default: on.
# RATE_LIMIT_ENABLED=true
# Where the browser tests read the e-mails the API sends (Mailpit).
# MAILPIT_URL=http://localhost:8025
# Browser tests: reuse the last build / print the stack's logs.
# E2E_SKIP_BUILD=1
# E2E_VERBOSE=1
# Port of the isolated API started by scripts/mobile/test-api.mjs (default 4100).
# MOBILE_TEST_API_PORT=4100

