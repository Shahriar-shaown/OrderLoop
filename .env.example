# Copy to .env (`cp .env.example .env`). Values below are local-development defaults that match
# infra/docker-compose.yml. They are not secrets. NEVER put real credentials in this file.

# --- Server (api, worker) ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://orderloop:orderloop@localhost:5433/orderloop
REDIS_URL=redis://localhost:6379

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

# --- Mobile (Expo) ---
# A physical phone cannot reach "localhost"; use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development
