# Copy to .env (`cp .env.example .env`). Values below are local-development defaults that match
# infra/docker-compose.yml. They are not secrets. NEVER put real credentials in this file.

# --- Server (api, worker) ---
# Required. development | test | production. Production enforces signing keys and a real mail provider.
NODE_ENV=development
API_PORT=4000
# Runtime role (app_user): NOBYPASSRLS, DML only. This is what api and worker use.
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5433/orderloop
# Migration role (app_migrator): owns tables, runs `prisma migrate`.
DATABASE_MIGRATION_URL=postgresql://app_migrator:app_migrator_dev@localhost:5433/orderloop
# Superuser, used ONLY by `pnpm db:setup` to create the two roles above. Never used at runtime.
DATABASE_ADMIN_URL=postgresql://orderloop:orderloop@localhost:5433/orderloop
REDIS_URL=redis://localhost:6379

# --- Auth ---
# EdDSA (Ed25519) signing key as a base64-encoded PKCS8 PEM, with the matching SPKI public key.
# Leave unset in development: an ephemeral key is generated at start-up (tokens die on restart).
# REQUIRED in production. Generate with: pnpm --filter @orderloop/api auth:generate-keys
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# After a refresh token is exchanged, presenting it again within this many seconds (0 to 60) is treated as a retry, not theft. 0 turns the grace off.
# REFRESH_REUSE_GRACE_SECONDS=10
# Browser origins allowed to call the API with cookies (comma-separated). Production: https only (the API refuses to start otherwise).
WEB_ORIGINS=http://localhost:3000
# Reverse-proxy hops in front of the API (0 = none). Set to the exact hop count in production so client IPs
# (rate limits, audit log) are real and X-Forwarded-For cannot be spoofed. Production REQUIRES >= 1; if clients really
# connect straight to the API, say so with TRUST_PROXY_NONE_OK=true.
TRUST_PROXY=0
# TRUST_PROXY_NONE_OK=false
# Serve GET /openapi.json to anyone (default true). Production recommendation: false (docs/api.md, "OpenAPI in production").
# OPENAPI_PUBLIC=true
# Who can sign up (create a new business): open (default outside production) | allowlist (pilot). PRODUCTION MUST CHOOSE: the API refuses
# to start with NODE_ENV=production and no REGISTRATION_MODE, so a deploy cannot quietly let anyone create a business.
# In allowlist mode POST /v1/auth/register answers
# 403 registration_closed for any other email; invitations to an existing business still work. The list is REQUIRED then:
# comma-separated exact emails and/or @domain.com entries, case-insensitive.
# REGISTRATION_MODE=open
# REGISTRATION_ALLOWED_EMAILS=owner@example.com,@pilot-company.example

# --- Couriers ---
# Courier credentials (Pathao, Steadfast) are stored encrypted with this key and never leave the API. 32 random bytes, base64:
#   openssl rand -base64 32
# Without it, couriers that need credentials cannot be connected (the simulated courier still works). Losing the key makes the
# saved credentials unreadable: sellers would have to enter them again. Rotate by setting a new key + id and moving the old one
# into COURIER_CREDENTIALS_OLD_KEYS=id:base64 (see docs/couriers.md).
# COURIER_CREDENTIALS_KEY=
# COURIER_CREDENTIALS_KEY_ID=k1
# COURIER_CREDENTIALS_OLD_KEYS=
# The simulated courier (nothing real is booked). On by default outside production; switch on deliberately there.
# COURIER_MOCK_ENABLED=true
# Public address of this API, shown to sellers as the webhook URL to paste into their courier's panel (must be https in production).
# API_PUBLIC_URL=https://api.example.com

# --- Monitoring (docs/operations/monitoring.md) ---
# Bearer token that opens GET /metrics (Prometheus format) on the API and on the worker's health server. Unset: /metrics answers 404 on both.
# 16+ characters, e.g. `openssl rand -hex 24`. Never put it in a URL.
# METRICS_TOKEN=
# Port of the worker's HTTP health and metrics server (/health/live, /health/ready, /metrics). Keep it off the public network.
# WORKER_HEALTH_PORT=4010

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent. Output is one JSON object per line; credentials are redacted.
LOG_LEVEL=info

# --- Email ---
# console : prints each email (including its one-time link) to the API log. Local development only; refused in production.
# smtp    : sends through SMTP_*. Locally use Mailpit (`pnpm services:mail`, inbox at http://localhost:8025):
#             MAIL_PROVIDER=smtp  SMTP_HOST=127.0.0.1  SMTP_PORT=1025
#           In production use your provider's SMTP credentials (see docs/api.md, "Email").
MAIL_PROVIDER=console
MAIL_FROM=OrderLoop <no-reply@orderloop.invalid>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_SECURE=true is TLS from the first byte (port 465). With false, production REQUIRES STARTTLS (requireTLS): a server that
# does not offer it is refused rather than sent the login and the message in clear text. Local Mailpit is fine (not production).
# SMTP_USER=
# SMTP_PASSWORD=

# --- Automation and notifications (docs/automation.md) ---
# Push: `dev` (default) only logs a redacted line and records the push as sent; set PUSH_DEV_OUTBOX to also append what it would
# have sent to a file (`tail -f` it). Nothing reaches a phone. `expo` posts to Expo's free push service (production). Give the API
# and the worker the same value; `dev` in production logs a loud warning.
PUSH_PROVIDER=dev
# PUSH_DEV_OUTBOX=/tmp/orderloop-push.jsonl
# EXPO_ACCESS_TOKEN=
# SMS and WhatsApp: `none` (default) makes the channel unavailable (422 channel_not_configured); `console` only logs. No vendor is
# integrated. Either also needs each recipient's own recorded consent.
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none

# --- Meta: Facebook Page Messenger + Instagram DMs as draft orders (docs/meta.md) ---
# mock (default): a labelled simulated provider, no Meta account involved; `pnpm meta:demo` walks through it.
# live: the real Meta. Implemented against Meta's documentation, NOT tested with authorised credentials. Needs ALL of:
#   META_APP_ID, META_APP_SECRET, META_WEBHOOK_VERIFY_TOKEN, META_GRAPH_VERSION, API_PUBLIC_URL (https), COURIER_CREDENTIALS_KEY
# Give the API and the worker the same values.
# Production must set META_MODE on purpose (the server refuses to start without it). In production the mock endpoints answer 404
# even with META_MODE=mock, unless META_ALLOW_MOCK_IN_PRODUCTION=true (pilot demos only, never next to real customers' data).
META_MODE=mock
# META_ALLOW_MOCK_IN_PRODUCTION=false
# META_APP_ID=
# The App Secret signs webhooks, the sign-in state and Meta's deauthorize / data-deletion requests. Never commit it.
# META_APP_SECRET=
# The string you also type as "Verify token" when subscribing the webhook in the Meta dashboard (16+ characters).
# META_WEBHOOK_VERIFY_TOKEN=
# Pinned on purpose, no default: check Meta's changelog for a version that is currently supported (e.g. v23.0).
# META_GRAPH_VERSION=
# Facebook Login for Business: the login configuration id (otherwise the classic scope dialog is used). Unverified, see meta.md.
# META_LOGIN_CONFIG_ID=
# Days to keep customer messages, unconfirmed and dismissed drafts before the worker deletes them.
# META_RETENTION_DAYS=30
# Where the sign-in with Meta (and TikTok Shop) returns to (default: the first WEB_ORIGINS entry).
# WEB_APP_URL=http://localhost:3000
# Your free ngrok dev domain (dashboard.ngrok.com > Domains), used by `pnpm tunnel` to give Meta and TikTok a stable public address.
# NGROK_DOMAIN=your-name.ngrok-free.app

# --- TikTok Shop: a READ-ONLY mirror of a shop's orders (in the shop's own currency, no buyer data) that reserves, releases and ships
# OrderLoop stock (docs/tiktok-shop.md). TikTok Shop is not available in Bangladesh: nothing here enters OrderLoop's BDT orders or finance.
# mock (default): a labelled simulated shop, no TikTok account involved; `pnpm tiktok:demo` walks through it.
# live: the real TikTok Shop API. Implemented from SDK sources, NEVER run against TikTok (no credentials exist). Needs ALL of:
#   TIKTOK_APP_KEY, TIKTOK_APP_SECRET (16+ characters), API_PUBLIC_URL (https), COURIER_CREDENTIALS_KEY
# Give the API and the worker the same values.
# Production must set TIKTOK_MODE on purpose (the server refuses to start without it). In production the mock endpoints answer 404
# even with TIKTOK_MODE=mock, unless TIKTOK_ALLOW_MOCK_IN_PRODUCTION=true (pilot demos only, never next to real stock).
TIKTOK_MODE=mock
# TIKTOK_ALLOW_MOCK_IN_PRODUCTION=false
# TIKTOK_APP_KEY=
# The app secret signs every API request, every webhook and the sign-in state. Never commit it.
# TIKTOK_APP_SECRET=
# Where sign-in/token calls and shop API calls go. A regional Partner Center may use other hosts: check partner.tiktokshop.com.
# TIKTOK_AUTH_HOST=https://auth.tiktok-shops.com
# TIKTOK_API_HOST=https://open-api.tiktokglobalshop.com
# The API version in every path, pinned on purpose.
# TIKTOK_API_VERSION=202309
# Days to keep mirrored orders that are in a final state (webhook events are kept 30 days). At least 30.
# TIKTOK_RETENTION_DAYS=180

# --- Data deletion (docs/privacy-and-deletion.md) ---
# Days between an owner asking to delete a business and the worker deleting it for good (1 to 365). The owner can cancel until then.
# TENANT_DELETION_GRACE_DAYS=14

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# The address shown on the public /data-deletion page. Set a real one before launch.
# NEXT_PUBLIC_PRIVACY_CONTACT=privacy@your-operator.example
NEXT_PUBLIC_APP_ENV=development

# --- Mobile (Expo) ---
# A physical phone cannot reach "localhost"; use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development
# Which build the app is (name and identifiers; see apps/mobile/app.config.ts): development (default) | preview | production.
# The EAS build profiles in apps/mobile/eas.json set it; a cloud build without it stops with an error.
# APP_VARIANT=development
# Marketing version of the app, and the Expo project id for `eas build` (created by `eas init`).
# The web app's host (e.g. app.example.com): when set, emailed links open the mobile app (see docs/mobile.md).
# APP_WEB_HOST=
# APP_VERSION=1.0.0
# EAS_PROJECT_ID=

# --- Development and test helpers (all optional) ---
# Per-IP request limits of the API; switched off by the browser tests. Default: on.
# RATE_LIMIT_ENABLED=true
# Where the browser tests read the e-mails the API sends (Mailpit).
# MAILPIT_URL=http://localhost:8025
# Browser tests: reuse the last build / print the stack's logs.
# E2E_SKIP_BUILD=1
# E2E_VERBOSE=1
# Port of the isolated API started by scripts/mobile/test-api.mjs (default 4100).
# MOBILE_TEST_API_PORT=4100

