{
  "uid": "orderloop-overview",
  "title": "OrderLoop overview",
  "tags": ["orderloop"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests per second by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(orderloop_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "API 5xx ratio (alert above 5%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orderloop_http_requests_total{status_class=\"5xx\"}[5m])) / sum(rate(orderloop_http_requests_total[5m]))",
          "legendFormat": "5xx ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "API latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(orderloop_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orderloop_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orderloop_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Slowest routes (p95 by route template)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(orderloop_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Route templates only; no ids or query strings ever reach a label."
    },
    {
      "id": 5,
      "title": "Dependencies up (API readiness)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orderloop_dependency_up",
          "legendFormat": "{{dependency}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "DB ping through the pool",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orderloop_db_ping_seconds",
          "legendFormat": "SELECT 1",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Queue depth (waiting + active + delayed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (orderloop_queue_jobs{state=~\"waiting|active|delayed\"})",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Oldest waiting job age (alert above 5 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orderloop_queue_oldest_waiting_age_seconds",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Failed jobs kept (automation = runs and deliveries that gave up)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orderloop_queue_jobs{state=\"failed\"}",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Worker heartbeat age (alert above 120 s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "orderloop_worker_heartbeat_age_seconds",
          "legendFormat": "heartbeat age",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "orderloop_worker_heartbeat_present",
          "legendFormat": "key present",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Worker jobs per minute by queue and result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, result) (rate(orderloop_worker_jobs_total[5m])) * 60",
          "legendFormat": "{{queue}} {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Last backup age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - orderloop_backup_last_success_timestamp_seconds",
          "legendFormat": "backup age",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Alert above 26 h. Absent if no backup was ever reported."
    },
    {
      "id": 13,
      "title": "CPU seconds per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=~\"api|worker\"}[5m])",
          "legendFormat": "{{job}} {{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Memory (resident)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"api|worker\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Event loop lag p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_seconds{quantile=\"0.99\"}",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "title": "Disk free",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"}",
          "legendFormat": "{{mountpoint}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "title": "PostgreSQL connections vs max",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "in use",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "max_connections",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "title": "Firing alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "orderloop-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "datasource": {
            "type": "prometheus",
            "uid": "orderloop-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "editable": false
}
