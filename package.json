{
  "name": "orderloop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node scripts/check-versions.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "turbo run lint typecheck test build && node --test scripts/*.test.mjs && node scripts/check-versions.mjs && node scripts/check-boundaries.mjs",
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "services:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "prettier": "^3.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
