{
  "name": "orderloop",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node scripts/check-versions.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm check:versions && pnpm check:boundaries && turbo run lint typecheck test build",
    "services:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.yml --profile mail down",
    "services:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:setup": "pnpm --filter @orderloop/db run setup-roles",
    "db:migrate": "pnpm --filter @orderloop/db migrate",
    "db:migrate:deploy": "pnpm --filter @orderloop/db migrate:deploy",
    "test:integration": "turbo run test:integration",
    "db:init": "pnpm db:setup && pnpm db:migrate:deploy",
    "db:seed": "pnpm --filter @orderloop/api db:seed",
    "automation:demo": "pnpm --filter @orderloop/api automation:demo",
    "meta:demo": "pnpm --filter @orderloop/api meta:demo",
    "meta:send-webhook": "pnpm --filter @orderloop/api meta:send-webhook",
    "inventory:verify": "pnpm --filter @orderloop/api inventory:verify",
    "sessions:revoke": "pnpm --filter @orderloop/api sessions:revoke",
    "services:mail": "docker compose -f infra/docker-compose.yml --profile mail up -d mailpit"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "prettier": "^3.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
