{
  "name": "@orderloop/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform UI components (React Native primitives; rendered on the web by react-native-web). Source package: apps compile it.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme-script": "./src/themeScript.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@orderloop/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "eslint": "^10.0.0",
    "jsdom": "^26.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "typescript": "6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react-native-safe-area-context": "~5.7.0"
  }
}
