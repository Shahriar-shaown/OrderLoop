// OrderLoop data model. Tenant-owned tables carry tenant_id and are protected by PostgreSQL
// row-level security (see prisma/migrations/*_rls). Global auth tables (users, sessions,
// refresh_tokens, user_tokens) are intentionally not tenant-scoped; the allowlist lives in src/tables.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
}

enum Language {
  en
  bn
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Global. One row per person.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)
  /// Set when the user proves they control the address (verification link, or accepting an invitation sent to it).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// The person's own interface language; a business has its own default (tenants.default_language).
  language        Language  @default(en)

  memberships     Membership[]
  sessions        Session[]
  userTokens      UserToken[]
  idempotencyKeys IdempotencyKey[]
  pushDevices     PushDevice[]

  @@map("users")
}

/// Tenant-scoped (RLS: id = app.tenant_id). User-facing name: "business" / "workspace".
model Tenant {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  logoUrl         String?  @map("logo_url")
  contactEmail    String?  @map("contact_email")
  contactPhone    String?  @map("contact_phone")
  addressLine1    String?  @map("address_line1")
  addressLine2    String?  @map("address_line2")
  city            String?
  district        String?
  postalCode      String?  @map("postal_code")
  /// ISO 3166-1 alpha-2.
  country         String   @default("BD")
  /// ISO 4217. Display and reporting currency; amounts are stored in minor units.
  currency        String   @default("BDT")
  /// IANA zone name.
  timezone        String   @default("Asia/Dhaka")
  defaultLanguage Language @default(en) @map("default_language")

  memberships          Membership[]
  invitations          Invitation[]
  categories           Category[]
  products             Product[]
  variants             ProductVariant[]
  locations            StockLocation[]
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  reservations         Reservation[]
  importJobs           ImportJob[]
  suppliers            Supplier[]
  customers            Customer[]
  orders               Order[]
  customerAddresses    CustomerAddress[]
  orderItems           OrderItem[]
  orderStatusHistories OrderStatusHistory[]
  courierConnections   CourierConnection[]
  shipments            Shipment[]
  shipmentEvents       ShipmentEvent[]
  settlementBatches    SettlementBatch[]
  settlementItems      SettlementItem[]
  settlementEvents     SettlementItemEvent[]
  discrepancies        Discrepancy[]
  manualCosts          ManualCost[]
  idempotencyKeys      IdempotencyKey[]
  automationRules      AutomationRule[]
  automationRuns       AutomationRun[]
  automationStates     AutomationState[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationDeliveries NotificationDelivery[]
  messagingConsents    MessagingConsent[]

  @@map("tenants")
}

/// Tenant-scoped (RLS: tenant_id = app.tenant_id, or user_id = app.user_id for SELECT).
model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]
  notificationPrefs NotificationPreference[]
  messagingConsents MessagingConsent[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Global. A login session; refresh tokens rotate within it.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Tenant the access token is currently scoped to (validated against memberships on every request).
  activeTenantId String    @map("active_tenant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?   @map("revoked_reason")
  userAgent      String?   @map("user_agent")
  ip             String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Global. Only the SHA-256 hash of the opaque token is stored.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token has been exchanged. Presenting a used token again is replay (reuse detection).
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Global. One-time emailed tokens (verification, password reset). Only the SHA-256 hash is stored.
model UserToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

/// Tenant-scoped.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

/// Tenant-scoped, append-only (app_user has INSERT and SELECT only). tenant_id is null for
/// events with no tenant context (for example a failed login for an unknown email).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------------------------------
// Catalog and inventory (Phase 2). Every table below is tenant-scoped: tenant_id, forced row-level security, and
// composite foreign keys (tenant_id, id) so a child row can never point at another tenant's parent.
// Check constraints (not expressible in Prisma) live in the migration: non-negative stock, reserved <= on_hand, and
// the allowed shape of each ledger movement type.
// ---------------------------------------------------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// RECEIVE +on_hand | ADJUSTMENT +/-on_hand | RESERVE +reserved | RELEASE -reserved | SHIP -on_hand and -reserved
/// DAMAGE -on_hand +damaged | WRITE_OFF -damaged | RETURN +on_hand or +damaged
enum StockMovementType {
  RECEIVE
  ADJUSTMENT
  RESERVE
  RELEASE
  SHIP
  /// Sellable stock found or made unsellable: -on_hand, +damaged.
  DAMAGE
  /// Damaged stock disposed of: -damaged.
  WRITE_OFF
  /// Stock coming back from a customer: +on_hand (resaleable) or +damaged.
  RETURN
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Lower-cased name, so "Shirts" and "shirts" cannot both exist in one tenant.
  nameKey   String   @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameKey])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  /// Lower-cased name. Not unique (two products may share a name); used for search and CSV import matching.
  nameKey     String        @map("name_key")
  description String?
  categoryId  String?       @map("category_id") @db.Uuid
  /// Who the product is bought from (optional). Same-tenant is enforced by the application, like the category.
  supplierId  String?       @map("supplier_id") @db.Uuid
  /// Links (https) to product pictures, first is the main one. Pictures are not uploaded to OrderLoop yet.
  imageUrls   String[]      @default([]) @map("image_urls")
  /// Unit of measure for every variant: pcs, kg, g, l, ml, m, pack, dozen.
  unit        String        @default("pcs")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Same-tenant is enforced by the application (a cross-tenant id is invisible under RLS) because Prisma cannot
  /// express a composite foreign key whose second column is nullable.
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@unique([tenantId, id])
  @@index([tenantId, nameKey])
  @@index([tenantId, status, createdAt])
  @@map("products")
}

/// A sellable, countable unit: one SKU. Every product has at least one.
model ProductVariant {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  /// Upper-case, unique per tenant. Immutable once created, because later phases reference it.
  sku          String
  /// Human label such as "Red / M". Empty for single-variant products.
  name         String    @default("")
  attributes   Json      @default("{}")
  /// Integer paisa (1 BDT = 100 paisa). Never a float.
  priceMinor   Int       @map("price_minor")
  costMinor    Int?      @map("cost_minor")
  barcode      String?
  /// Low-stock alert threshold on available quantity (0 disables).
  reorderPoint Int       @default(0) @map("reorder_point")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations Reservation[]
  orderItems   OrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

/// Who products are bought from. Tenant-scoped.
model Supplier {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  /// Lower-cased name, unique per tenant.
  nameKey     String    @map("name_key")
  contactName String?   @map("contact_name")
  phone       String?
  email       String?
  address     String?
  notes       String?
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameKey])
  @@map("suppliers")
}

model StockLocation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  nameKey    String    @map("name_key")
  /// Where stock goes when a request names no location. At most one per tenant.
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations Reservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameKey])
  @@map("stock_locations")
}

/// Materialised current quantity per variant and location. Always equals the sum of that pair's ledger movements;
/// changed only by the stock operations in packages/catalog, in the same transaction as the movement row.
model StockLevel {
  tenantId   String   @map("tenant_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// Physically on the shelf.
  onHand     Int      @default(0) @map("on_hand")
  /// Physically here but unsellable. Not part of on_hand, so it is never available to sell or reserve.
  damaged    Int      @default(0)
  /// Promised to open reservations. Available to sell = onHand - reservedQty (never negative).
  reserved   Int      @default(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, variantId, locationId])
  @@map("stock_levels")
}

/// Append-only stock ledger (app_user has INSERT and SELECT only). Each row is a signed change to on_hand and/or
/// reserved; replaying all rows for a variant and location reproduces stock_levels exactly.
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Strict, gap-tolerant total order of the ledger, assigned by the database. Use this, not created_at, to replay.
  seq            BigInt            @unique @default(autoincrement())
  tenantId       String            @map("tenant_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  locationId     String            @map("location_id") @db.Uuid
  type           StockMovementType
  onHandDelta    Int               @map("on_hand_delta")
  reservedDelta  Int               @map("reserved_delta")
  damagedDelta   Int               @default(0) @map("damaged_delta")
  reason         String?
  /// What caused it (for example an order in a later phase), as free references; not foreign keys.
  referenceType  String?           @map("reference_type")
  referenceId    String?           @map("reference_id")
  reservationId  String?           @map("reservation_id") @db.Uuid
  /// Client-supplied key making a retried request a no-op. Unique per tenant when present.
  idempotencyKey String?           @map("idempotency_key")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model Reservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, variantId])
  @@map("reservations")
}

/// A bulk CSV import, processed by the worker. The raw CSV is kept only until processing finishes.
model ImportJob {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  kind        String
  status      ImportStatus @default(PENDING)
  csv         String?
  totalRows   Int?         @map("total_rows")
  created     Int          @default(0)
  updated     Int          @default(0)
  failed      Int          @default(0)
  /// First 100 problems: [{ row, message }]. Never contains the CSV content beyond the offending field name.
  errors      Json         @default("[]")
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt   DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------------------------------------------------
// Customers and orders (Phase 3). Tenant-scoped like everything above. Money is integer paisa; the database repeats the
// order arithmetic as CHECK constraints. order_status_history is append-only.
// ---------------------------------------------------------------------------------------------------------------------

enum OrderStatus {
  pending_confirmation
  confirmed
  ready_to_ship
  shipped
  in_transit
  delivered
  delivery_failed
  cancelled
  return_requested
  returned
}

enum OrderSource {
  facebook
  instagram
  whatsapp
  phone_call
  website
  walk_in
  other
}

model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Lower-cased name, for search.
  nameKey   String   @map("name_key")
  /// Canonical +8801XXXXXXXXX. The identity of a customer within a business.
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, nameKey])
  @@map("customers")
}

model CustomerAddress {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  label         String?
  recipientName String   @map("recipient_name")
  /// Canonical +8801XXXXXXXXX. May differ from the customer's own (a gift, a relative's address).
  phone         String
  line1         String
  /// Thana or upazila.
  area          String
  district      String
  division      String
  postalCode    String?  @map("postal_code")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("customer_addresses")
}

/// Per-business order numbers. One row per tenant, advanced with a row lock inside the order's own transaction, so numbers
/// are unique, ascending, and a rolled-back order does not burn one.
model OrderCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  nextNumber Int    @default(1001) @map("next_number")

  @@map("order_counters")
}

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  orderNumber     Int         @map("order_number")
  customerId      String      @map("customer_id") @db.Uuid
  status          OrderStatus @default(pending_confirmation)
  source          OrderSource @default(other)
  /// Where it came from: a Facebook post or chat link, a campaign, who took the call.
  sourceReference String?     @map("source_reference")
  notes           String?

  /// The delivery address as it was when the order was made. Later edits to the customer's address book never rewrite it.
  shipName       String  @map("ship_name")
  shipPhone      String  @map("ship_phone")
  shipLine1      String  @map("ship_line1")
  shipArea       String  @map("ship_area")
  shipDistrict   String  @map("ship_district")
  shipDivision   String  @map("ship_division")
  shipPostalCode String? @map("ship_postal_code")

  subtotalMinor       Int @map("subtotal_minor")
  discountMinor       Int @default(0) @map("discount_minor")
  deliveryChargeMinor Int @default(0) @map("delivery_charge_minor")
  totalMinor          Int @map("total_minor")
  advancePaidMinor    Int @default(0) @map("advance_paid_minor")
  /// total - advance. Computed by the server, never accepted from a client.
  codAmountMinor      Int @map("cod_amount_minor")

  /// A retried create with the same key returns this order instead of making another.
  idempotencyKey String?  @map("idempotency_key")
  /// Hash of the request that created it, so reusing a key for a different order is refused.
  requestHash    String?  @map("request_hash")
  /// Bumped on every change; clients can send the one they saw to avoid overwriting someone else's edit.
  version        Int      @default(1)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items           OrderItem[]
  history         OrderStatusHistory[]
  shipments       Shipment[]
  settlementItems SettlementItem[]
  discrepancies   Discrepancy[]
  manualCosts     ManualCost[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, shipPhone])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  position       Int
  variantId      String  @map("variant_id") @db.Uuid
  /// What was sold, as it was then: later renames or price changes do not rewrite past orders.
  sku            String
  productName    String  @map("product_name")
  variantName    String  @default("") @map("variant_name")
  quantity       Int
  unitPriceMinor Int     @map("unit_price_minor")
  discountMinor  Int     @default(0) @map("discount_minor")
  lineTotalMinor Int     @map("line_total_minor")
  /// Cost at the time, for profit reporting later.
  costMinor      Int?    @map("cost_minor")
  /// The stock held for this line while the order is confirmed or ready to ship.
  reservationId  String? @map("reservation_id") @db.Uuid

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@index([tenantId, variantId])
  @@map("order_items")
}

/// Append-only (app_user has INSERT and SELECT only). One row per status the order has been in, including its creation.
model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  reason      String?
  actorUserId String?      @map("actor_user_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId, createdAt])
  @@map("order_status_history")
}

enum CourierProvider {
  mock
  pathao
  steadfast
}

enum CourierEnvironment {
  simulated
  sandbox
  production
}

enum ShipmentStatus {
  /// We have claimed the order and are about to ask (or are asking) the courier.
  booking
  /// The courier refused, or never received it: nothing exists at the courier.
  booking_failed
  /// We asked and do not know the answer (timeout, 5xx). A parcel may or may not exist; a person or a lookup must settle it.
  booking_uncertain
  booked
  picked_up
  in_transit
  out_for_delivery
  delivered
  partial_delivered
  delivery_failed
  on_hold
  returning
  returned
  cancelled
  unknown
}

enum ShipmentEventSource {
  booking
  webhook
  poll
  manual
  simulation
}

/// A seller's link to one courier. Secrets are stored only as AES-256-GCM ciphertext and are never returned by the API.
model CourierConnection {
  id               String             @id @default(uuid(7)) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  provider         CourierProvider
  environment      CourierEnvironment
  /// Encrypted JSON of the provider credentials (client secret, API key ...).
  credentialsEnc   String?            @map("credentials_enc")
  /// Encrypted secret the courier sends with its webhooks, chosen by the seller.
  webhookSecretEnc String?            @map("webhook_secret_enc")
  /// Non-secret choices: store id, delivery type, default weight, host.
  settings         Json               @default("{}")
  enabled          Boolean            @default(true)
  lastCheckedAt    DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  lastCheckOk      Boolean?           @map("last_check_ok")
  lastCheckMessage String?            @map("last_check_message")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@unique([tenantId, id])
  @@unique([tenantId, provider])
  @@map("courier_connections")
}

model Shipment {
  id                    String             @id @default(uuid(7)) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  orderId               String             @map("order_id") @db.Uuid
  connectionId          String             @map("connection_id") @db.Uuid
  provider              CourierProvider
  environment           CourierEnvironment
  /// True for anything booked with the mock adapter: no courier knows about it and no parcel exists.
  simulated             Boolean
  status                ShipmentStatus
  /// The courier's own wording, exactly as last received.
  providerStatus        String?            @map("provider_status")
  providerConsignmentId String?            @map("provider_consignment_id")
  /// What we sent as the courier's reference for this parcel (Pathao merchant_order_id, Steadfast invoice).
  providerReference     String             @map("provider_reference")
  trackingCode          String?            @map("tracking_code")
  trackingUrl           String?            @map("tracking_url")
  /// 1 for the first booking of an order; a rebooking after a cancel or failure gets the next number and its own reference.
  attempt               Int                @default(1)
  codAmountMinor        Int                @map("cod_amount_minor")
  deliveryFeeMinor      Int?               @map("delivery_fee_minor")
  failureReason         String?            @map("failure_reason")
  idempotencyKey        String?            @map("idempotency_key")
  requestHash           String?            @map("request_hash")
  bookedAt              DateTime?          @map("booked_at") @db.Timestamptz(3)
  lastEventAt           DateTime?          @map("last_event_at") @db.Timestamptz(3)
  lastSyncedAt          DateTime?          @map("last_synced_at") @db.Timestamptz(3)
  createdById           String?            @map("created_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order             @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  connection      CourierConnection @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  events          ShipmentEvent[]
  settlementItems SettlementItem[]
  discrepancies   Discrepancy[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderId, attempt])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, provider, providerReference])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, providerConsignmentId])
  @@map("shipments")
}

/// What the courier told us (or what we did), one row per fact. Append-only.
model ShipmentEvent {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  shipmentId     String              @map("shipment_id") @db.Uuid
  source         ShipmentEventSource
  /// Identifies one delivery of one courier event, so a replayed webhook is recognised and ignored.
  eventKey       String              @map("event_key")
  providerStatus String?             @map("provider_status")
  /// Our status after this event, or null when the event changed nothing (duplicate, out of order).
  mappedStatus   ShipmentStatus?     @map("mapped_status")
  applied        Boolean
  note           String?
  payload        Json?
  occurredAt     DateTime?           @map("occurred_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, shipmentId, eventKey])
  @@index([tenantId, shipmentId, createdAt])
  @@map("shipment_events")
}

enum SettlementKind {
  cod
  return
  adjustment
}

enum SettlementMatchStatus {
  /// Tied to a parcel, by a reliable identifier or by a person.
  matched
  /// Names a parcel we cannot find.
  unmatched
  /// Names more than one parcel, or identifiers disagree. Never guessed: a person decides.
  ambiguous
  /// A fee or adjustment that belongs to no parcel (a monthly charge). It counts as a cost and blocks nothing.
  unallocated
  /// The same line was already recorded. Kept for the record, never counted.
  duplicate
  /// A person decided the line is not ours. Excluded from every figure.
  ignored
}

enum SettlementMatchMethod {
  consignment_id
  tracking_code
  reference
  order_number
  manual
}

enum DiscrepancyType {
  short_paid
  over_paid
  cash_before_delivery
  cash_on_closed_order
  fee_differs
  file_arithmetic
}

enum DiscrepancyStatus {
  open
  resolved
  /// A person accepted the difference (a shortfall written off).
  waived
}

enum CostKind {
  packaging
  advertising
  delivery_charge
  return_charge
  courier_deduction
  other
}

/// One courier statement as imported. The same file can never be imported twice (its content hash is unique).
model SettlementBatch {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  provider       CourierProvider
  fileName       String?         @map("file_name")
  fileHash       String          @map("file_hash")
  statementRef   String?         @map("statement_ref")
  rowCount       Int             @map("row_count")
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set only by an explicit "reconcile", and only when nothing in the batch is unmatched or in doubt. Cleared if that changes.
  reconciledAt   DateTime?       @map("reconciled_at") @db.Timestamptz(3)
  reconciledById String?         @map("reconciled_by_id") @db.Uuid

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  SettlementItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, fileHash])
  @@index([tenantId, createdAt])
  @@map("settlement_batches")
}

/// One line of a statement. Amounts are paisa.
model SettlementItem {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  batchId             String                 @map("batch_id") @db.Uuid
  lineNo              Int                    @map("line_no")
  /// Identifies what the line says, so the same line is not recorded twice (a unique index covers every non-duplicate).
  itemKey             String                 @map("item_key")
  kind                SettlementKind
  transactionId       String?                @map("transaction_id")
  consignmentId       String?                @map("consignment_id")
  trackingCode        String?                @map("tracking_code")
  reference           String?
  phone               String?
  itemDate            DateTime               @map("item_date") @db.Date
  collectedMinor      Int                    @map("collected_minor")
  deliveryChargeMinor Int                    @map("delivery_charge_minor")
  codFeeMinor         Int                    @map("cod_fee_minor")
  returnChargeMinor   Int                    @map("return_charge_minor")
  otherDeductionMinor Int                    @map("other_deduction_minor")
  /// collected - every charge. Worked out by us; the file's own figure (if any) is kept beside it.
  netMinor            Int                    @map("net_minor")
  fileNetMinor        Int?                   @map("file_net_minor")
  note                String?
  raw                 Json
  matchStatus         SettlementMatchStatus  @map("match_status")
  matchMethod         SettlementMatchMethod? @map("match_method")
  matchNote           String?                @map("match_note")
  shipmentId          String?                @map("shipment_id") @db.Uuid
  orderId             String?                @map("order_id") @db.Uuid
  duplicateOfId       String?                @map("duplicate_of_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch         SettlementBatch       @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict)
  shipment      Shipment?             @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)
  order         Order?                @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  events        SettlementItemEvent[]
  discrepancies Discrepancy[]

  @@unique([tenantId, id])
  @@unique([tenantId, batchId, lineNo])
  @@index([tenantId, batchId])
  @@index([tenantId, shipmentId])
  @@index([tenantId, orderId])
  @@index([tenantId, matchStatus])
  @@index([tenantId, itemDate])
  @@map("settlement_items")
}

/// Everything that happened to a line, who did it and why. Append-only.
model SettlementItemEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  note        String?
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   SettlementItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, itemId, createdAt])
  @@map("settlement_item_events")
}

/// A difference between what we expected and what a statement says. Never deleted; resolved or waived with a reason.
model Discrepancy {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  type              DiscrepancyType
  /// `item:<id>` for a problem with one line, `shipment:<id>` for a problem with a parcel's total. One of each type at a time.
  subjectKey        String            @map("subject_key")
  itemId            String?           @map("item_id") @db.Uuid
  shipmentId        String?           @map("shipment_id") @db.Uuid
  orderId           String?           @map("order_id") @db.Uuid
  status            DiscrepancyStatus @default(open)
  expectedMinor     Int?              @map("expected_minor")
  actualMinor       Int?              @map("actual_minor")
  message           String
  /// The actual amount when it was closed: a closed discrepancy reopens if the figures later change.
  closedActualMinor Int?              @map("closed_actual_minor")
  resolution        String?
  resolvedById      String?           @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     SettlementItem? @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  shipment Shipment?       @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)
  order    Order?          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, subjectKey, type])
  @@index([tenantId, status])
  @@map("discrepancies")
}

/// A cost entered by hand (packaging, advertising ...). Voided, never deleted. Courier charges come from statements, not from here.
model ManualCost {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  kind           CostKind
  amountMinor    Int       @map("amount_minor")
  incurredOn     DateTime  @map("incurred_on") @db.Date
  orderId        String?   @map("order_id") @db.Uuid
  note           String
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidReason     String?   @map("void_reason")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, incurredOn])
  @@map("manual_costs")
}

/// Tenant-scoped, or user-scoped when tenant_id is null (creating a business happens before the tenant exists). A retried
/// create returns the response stored here instead of creating again. Rows are purged after a day.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, key])
  @@unique([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------------------------------------------------
// Automation and notifications. Tenant-scoped like everything above (tenant_id, forced row-level security, composite
// foreign keys), except push_devices, which belongs to a person and so to all of their businesses (see docs/automation.md).
// ---------------------------------------------------------------------------------------------------------------------

enum AutomationKind {
  LOW_STOCK
  NEW_ORDER
  UNCONFIRMED_ORDER
  DELAYED_ORDER
  COD_DISCREPANCY
  DAILY_REPORT
  WEEKLY_REPORT
}

/// in_app is the notification itself (one delivery row, born sent); the rest are sent by the worker.
enum NotificationChannel {
  in_app
  push
  email
  sms
  whatsapp
}

enum DeliveryStatus {
  pending
  sent
  failed
  skipped
}

enum AutomationRunStatus {
  queued
  running
  succeeded
  failed
  skipped
}

enum AutomationTrigger {
  scheduled
  event
  manual
  retry
}

enum PushPlatform {
  ios
  android
}

enum PushProviderKind {
  expo
  dev
}

enum MessagingChannel {
  sms
  whatsapp
}

/// One row per (business, kind), created the first time someone saves it; until then the API shows defaults, disabled.
model AutomationRule {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  kind        AutomationKind
  enabled     Boolean        @default(false)
  /// Validated per kind by the contracts package (a zod discriminated union); stored without the kind.
  config      Json           @default("{}")
  /// { inApp, push, email, sms, whatsapp }
  channels    Json           @default("{}")
  /// When the rule was last switched on: events and catch-up scans ignore orders created before it.
  enabledAt   DateTime?      @map("enabled_at") @db.Timestamptz(3)
  updatedById String?        @map("updated_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]
  states AutomationState[]

  @@unique([tenantId, id])
  @@unique([tenantId, kind])
  @@map("automation_rules")
}

/// One evaluation of one rule. (rule_id, slot_key) is the idempotent scheduling slot: a second execution of the same slot is
/// a no-op, or resumes a failed run.
model AutomationRun {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  ruleId       String              @map("rule_id") @db.Uuid
  kind         AutomationKind
  /// `scan:20261025T1430Z`, `daily:2026-03-29`, `weekly:2026-W13`, `neworder-<orderId>`, `manual:<key>`.
  slotKey      String              @map("slot_key")
  trigger      AutomationTrigger
  scheduledFor DateTime            @map("scheduled_for") @db.Timestamptz(3)
  status       AutomationRunStatus @default(queued)
  attempts     Int                 @default(0)
  error        String?
  createdCount Int                 @default(0) @map("created_count")
  skippedCount Int                 @default(0) @map("skipped_count")
  startedAt    DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?           @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule          AutomationRule @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Restrict)
  notifications Notification[]

  @@unique([tenantId, id])
  @@unique([ruleId, slotKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("automation_runs")
}

/// Episode tracking: a subject (a variant, an order, a discrepancy) the rule has already told people about. It stays quiet
/// until the subject stops matching (stock recovers, the order is confirmed), when the row is removed and the rule re-arms.
model AutomationState {
  tenantId       String   @map("tenant_id") @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  subjectId      String   @map("subject_id")
  /// How many notifications this episode has produced (unconfirmed-order reminders are capped).
  count          Int      @default(1)
  lastNotifiedAt DateTime @map("last_notified_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   AutomationRule @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Restrict)

  @@id([ruleId, subjectId])
  @@index([tenantId, ruleId])
  @@map("automation_state")
}

/// One per recipient. Titles, bodies and data hold order numbers, SKUs, counts and business totals, never customer data.
model Notification {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  runId     String?        @map("run_id") @db.Uuid
  kind      AutomationKind
  title     String
  body      String
  /// Ids and counts only, for deep links.
  data      Json           @default("{}")
  /// Makes creating it twice impossible: (tenant, user, dedupe_key) is unique.
  dedupeKey String         @map("dedupe_key")
  /// Whether it shows in the app's list (the person may have in-app switched off but still want a push or an email).
  inApp     Boolean        @default(true) @map("in_app")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime?      @map("read_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     Membership             @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  run        AutomationRun?         @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId, dedupeKey])
  @@index([tenantId, userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, runId])
  @@map("notifications")
}

model NotificationPreference {
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      AutomationKind
  inApp     Boolean        @default(true) @map("in_app")
  push      Boolean        @default(true)
  email     Boolean        @default(false)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, userId, kind])
  @@map("notification_preferences")
}

/// (notification_id, channel) is unique, so a retry can never create a second delivery, and the worker's claim
/// (status pending or failed, not leased) can never send one twice.
model NotificationDelivery {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(pending)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  /// Set while a worker holds the delivery; a lease, so two workers never send the same one.
  claimedAt      DateTime?           @map("claimed_at") @db.Timestamptz(3)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([notificationId, channel])
  @@index([tenantId, status, createdAt])
  @@map("notification_deliveries")
}

/// Global (a person's phone belongs to the person, whatever business they are in). Registration is an upsert by token;
/// sign-out removes it. Row-level security confines each user to their own rows, plus the members of the current business
/// for the worker's reads; the cross-user writes are two narrow SECURITY DEFINER functions.
model PushDevice {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  token      String           @unique
  platform   PushPlatform
  provider   PushProviderKind
  lastSeenAt DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// A member's own consent to receive sms or whatsapp from a business, with the number to use. Only they can change it.
model MessagingConsent {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  channel   MessagingChannel
  phone     String
  grantedAt DateTime         @map("granted_at") @db.Timestamptz(3)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(3)
  /// Where it was given (`app`).
  source    String

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@unique([tenantId, userId, channel])
  @@map("messaging_consents")
}
