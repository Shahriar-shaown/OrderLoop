// OrderLoop data model. Tenant-owned tables carry tenant_id and are protected by PostgreSQL
// row-level security (see prisma/migrations/*_rls). Global auth tables (users, sessions,
// refresh_tokens, user_tokens) are intentionally not tenant-scoped; the allowlist lives in src/tables.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
}

enum Language {
  en
  bn
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Global. One row per person.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)
  /// Set when the user proves they control the address (verification link, or accepting an invitation sent to it).
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// The person's own interface language; a business has its own default (tenants.default_language).
  language        Language  @default(en)

  memberships Membership[]
  sessions    Session[]
  userTokens  UserToken[]

  @@map("users")
}

/// Tenant-scoped (RLS: id = app.tenant_id). User-facing name: "business" / "workspace".
model Tenant {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  logoUrl         String?  @map("logo_url")
  contactEmail    String?  @map("contact_email")
  contactPhone    String?  @map("contact_phone")
  addressLine1    String?  @map("address_line1")
  addressLine2    String?  @map("address_line2")
  city            String?
  district        String?
  postalCode      String?  @map("postal_code")
  /// ISO 3166-1 alpha-2.
  country         String   @default("BD")
  /// ISO 4217. Display and reporting currency; amounts are stored in minor units.
  currency        String   @default("BDT")
  /// IANA zone name.
  timezone        String   @default("Asia/Dhaka")
  defaultLanguage Language @default(en) @map("default_language")

  memberships    Membership[]
  invitations    Invitation[]
  categories     Category[]
  products       Product[]
  variants       ProductVariant[]
  locations      StockLocation[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  reservations   Reservation[]
  importJobs     ImportJob[]

  @@map("tenants")
}

/// Tenant-scoped (RLS: tenant_id = app.tenant_id, or user_id = app.user_id for SELECT).
model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Global. A login session; refresh tokens rotate within it.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Tenant the access token is currently scoped to (validated against memberships on every request).
  activeTenantId String    @map("active_tenant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?   @map("revoked_reason")
  userAgent      String?   @map("user_agent")
  ip             String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Global. Only the SHA-256 hash of the opaque token is stored.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token has been exchanged. Presenting a used token again is replay (reuse detection).
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Global. One-time emailed tokens (verification, password reset). Only the SHA-256 hash is stored.
model UserToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_tokens")
}

/// Tenant-scoped.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  role        Role
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

/// Tenant-scoped, append-only (app_user has INSERT and SELECT only). tenant_id is null for
/// events with no tenant context (for example a failed login for an unknown email).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------------------------------
// Catalog and inventory (Phase 2). Every table below is tenant-scoped: tenant_id, forced row-level security, and
// composite foreign keys (tenant_id, id) so a child row can never point at another tenant's parent.
// Check constraints (not expressible in Prisma) live in the migration: non-negative stock, reserved <= on_hand, and
// the allowed shape of each ledger movement type.
// ---------------------------------------------------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

/// RECEIVE +on_hand | ADJUSTMENT +/-on_hand | RESERVE +reserved | RELEASE -reserved | SHIP -on_hand and -reserved
enum StockMovementType {
  RECEIVE
  ADJUSTMENT
  RESERVE
  RELEASE
  SHIP
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Lower-cased name, so "Shirts" and "shirts" cannot both exist in one tenant.
  nameKey   String   @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameKey])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  /// Lower-cased name. Not unique (two products may share a name); used for search and CSV import matching.
  nameKey     String        @map("name_key")
  description String?
  categoryId  String?       @map("category_id") @db.Uuid
  /// Unit of measure for every variant: pcs, kg, g, l, ml, m, pack, dozen.
  unit        String        @default("pcs")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Same-tenant is enforced by the application (a cross-tenant id is invisible under RLS) because Prisma cannot
  /// express a composite foreign key whose second column is nullable.
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]

  @@unique([tenantId, id])
  @@index([tenantId, nameKey])
  @@index([tenantId, status, createdAt])
  @@map("products")
}

/// A sellable, countable unit: one SKU. Every product has at least one.
model ProductVariant {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  /// Upper-case, unique per tenant. Immutable once created, because later phases reference it.
  sku          String
  /// Human label such as "Red / M". Empty for single-variant products.
  name         String    @default("")
  attributes   Json      @default("{}")
  /// Integer paisa (1 BDT = 100 paisa). Never a float.
  priceMinor   Int       @map("price_minor")
  costMinor    Int?      @map("cost_minor")
  barcode      String?
  /// Low-stock alert threshold on available quantity (0 disables).
  reorderPoint Int       @default(0) @map("reorder_point")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations Reservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model StockLocation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  nameKey    String    @map("name_key")
  /// Where stock goes when a request names no location. At most one per tenant.
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]
  movements    StockMovement[]
  reservations Reservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, nameKey])
  @@map("stock_locations")
}

/// Materialised current quantity per variant and location. Always equals the sum of that pair's ledger movements;
/// changed only by the stock operations in packages/catalog, in the same transaction as the movement row.
model StockLevel {
  tenantId   String   @map("tenant_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  /// Physically on the shelf.
  onHand     Int      @default(0) @map("on_hand")
  /// Promised to open reservations. Available to sell = onHand - reservedQty (never negative).
  reserved   Int      @default(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, variantId, locationId])
  @@map("stock_levels")
}

/// Append-only stock ledger (app_user has INSERT and SELECT only). Each row is a signed change to on_hand and/or
/// reserved; replaying all rows for a variant and location reproduces stock_levels exactly.
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Strict, gap-tolerant total order of the ledger, assigned by the database. Use this, not created_at, to replay.
  seq            BigInt            @unique @default(autoincrement())
  tenantId       String            @map("tenant_id") @db.Uuid
  variantId      String            @map("variant_id") @db.Uuid
  locationId     String            @map("location_id") @db.Uuid
  type           StockMovementType
  onHandDelta    Int               @map("on_hand_delta")
  reservedDelta  Int               @map("reserved_delta")
  reason         String?
  /// What caused it (for example an order in a later phase), as free references; not foreign keys.
  referenceType  String?           @map("reference_type")
  referenceId    String?           @map("reference_id")
  reservationId  String?           @map("reservation_id") @db.Uuid
  /// Client-supplied key making a retried request a no-op. Unique per tenant when present.
  idempotencyKey String?           @map("idempotency_key")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model Reservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt    DateTime?         @map("resolved_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  location StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, variantId])
  @@map("reservations")
}

/// A bulk CSV import, processed by the worker. The raw CSV is kept only until processing finishes.
model ImportJob {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  kind        String
  status      ImportStatus @default(PENDING)
  csv         String?
  totalRows   Int?         @map("total_rows")
  created     Int          @default(0)
  updated     Int          @default(0)
  failed      Int          @default(0)
  /// First 100 problems: [{ row, message }]. Never contains the CSV content beyond the offending field name.
  errors      Json         @default("[]")
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt   DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("import_jobs")
}
