{
  "name": "@orderloop/features",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The product's screens and the logic behind them, written once for web and mobile. Source package: apps compile it. Apps stay thin: they provide a router adapter and mount a screen per route.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@orderloop/api-client": "workspace:*",
    "@orderloop/contracts": "workspace:*",
    "@orderloop/domain": "workspace:*",
    "@orderloop/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.4",
    "react-hook-form": "^7.90.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-native": "*"
  },
  "devDependencies": {
    "@orderloop/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^10.0.0",
    "jsdom": "^26.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4",
    "typescript": "6.0.3",
    "vitest": "^3.0.0"
  }
}
